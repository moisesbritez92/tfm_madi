%% ---------------------------------------------------------------------------
%% tecnun-tfm.sty - Estilo para memorias de Proyecto Fin de Master (Tecnun)
%% Modelado sobre el formato de "Vera Aguinaga, Jorge_TFM_MADI".
%% Citas en IEEE (bibtex + IEEEtran.bst). Texto justificado, interlineado
%% sencillo, presentacion sobria.
%% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tecnun-tfm}[2026/08/24 v1.0 Plantilla TFM Tecnun estilo IEEE]

% --- Codificacion e idioma ---------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
% es-nodecimaldot: sin ella babel convierte todo punto en modo matematico en coma,
% incluido el separador de millares de siunitx (\num{3000} salia como "3,000").
\RequirePackage[spanish,es-tabla,es-noquoting,es-lcroman,es-nodecimaldot]{babel}
\RequirePackage{csquotes}

% --- Matematicas (antes de la fuente, que redefine simbolos AMS) -------------
\RequirePackage{amsmath}

% --- Tipografia: Arial o similar (normas de redaccion) ----------------------
% Helvetica escalada es la sustituta metrica habitual de Arial en LaTeX.
\RequirePackage{helvet}   % sin escalar: las normas piden 11 pt reales
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage{newtxsf}          % matematicas sans, a juego con el texto
\RequirePackage{microtype}
\RequirePackage[normalem]{ulem}   % \uline para los titulos subrayados

% Babel-spanish traduce los operadores matematicos (max->max con tilde,
% min->min con tilde, lim->lim con tilde) y compone la tilde como acento
% matematico. Con newtxsf el acento cae sobre la letra y los glifos se solapan.
% Se redefinen en modo texto, donde la fuente T1 si tiene los caracteres.
% Babel reaplica sus definiciones en cada cambio de idioma, de ahi el \addto:
% las nuestras deben ejecutarse despues, tambien tras un \selectlanguage.
\newcommand{\tfm@operadores}{%
  \renewcommand{\max}{\mathop{\text{m\'ax}}\limits}%
  \renewcommand{\min}{\mathop{\text{m\'{\i}n}}\limits}%
  \renewcommand{\lim}{\mathop{\text{l\'{\i}m}}\limits}%
}
\AtBeginDocument{%
  \addto\extrasspanish{\tfm@operadores}%
  \tfm@operadores
}

% --- Caja de pagina ----------------------------------------------------------
% Normas: DIN A4, superior 35 mm, inferior 30 mm, izquierdo 30 mm, derecho 25 mm.
% A doble cara, "izquierdo/derecho" se traducen en interior/exterior.
\RequirePackage[a4paper,top=35mm,bottom=30mm,inner=30mm,outer=25mm,
                headheight=15pt,headsep=8mm,footskip=12mm]{geometry}

% Interlineado sencillo y parrafos con separacion (sin sangria doble marca)
\RequirePackage{setspace}
\singlespacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt plus 2pt minus 1pt}

% --- Utilidades --------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{enumitem}
\RequirePackage{siunitx}
\RequirePackage{xcolor}
\RequirePackage{listings}
% El diagrama del flujo de evaluacion del apartado de metricas es la unica
% figura vectorial hecha dentro del documento; el resto llega como PDF.
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,fit,backgrounds}
\RequirePackage[bottom,hang]{footmisc}

% group-digits=integer: sin ella el agrupamiento tambien parte los decimales y
% \num{0.8645} sale como "0,864.5".
\sisetup{output-decimal-marker={,},group-separator={.},group-minimum-digits=4,
         group-digits=integer}
\setlist{itemsep=2pt,parsep=0pt,topsep=4pt}

