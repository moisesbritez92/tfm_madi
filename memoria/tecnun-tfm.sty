\newcommand{\tfmautor}[1]{\def\@tfmautor{#1}}
\newcommand{\tfmmaster}[1]{\def\@tfmmaster{#1}}
\newcommand{\tfmtipo}[1]{\def\@tfmtipo{#1}}
\newcommand{\tfmdirector}[1]{\def\@tfmdirector{#1}}
\newcommand{\tfmlugar}[1]{\def\@tfmlugar{#1}}
\newcommand{\tfmfecha}[1]{\def\@tfmfecha{#1}}
\tfmtipo{Proyecto Fin de M\'aster}
\tfmtitulo{T\'itulo de la memoria}
\tfmtitulocorto{T\'itulo de la memoria}
\tfmautor{Nombre Apellidos}
\tfmmaster{AN\'ALISIS DE DATOS EN INGENIER\'IA}
\tfmdirector{}
