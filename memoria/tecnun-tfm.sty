% Accesores publicos de los datos (para usarlos fuera del .sty)
\newcommand{\tfmtipoactual}{\@tfmtipo}
\newcommand{\tfmmasteractual}{\@tfmmaster}
\newcommand{\tfmtituloactual}{\@tfmtitulo}
\newcommand{\tfmautoractual}{\@tfmautor}
