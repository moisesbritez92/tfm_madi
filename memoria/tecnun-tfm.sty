\newcommand{\logotecnun}[1]{\def\@logotecnun{#1}}
\logotecnun{img/logo-tecnun.pdf}

\newcommand{\piecentro}{%
  P\textsuperscript{o} Manuel Lardizabal, 13. 20018 Donostia-San Sebasti\'an, Gipuzkoa\\
  Tel. 943 219 877 $\cdot$ Fax 943 311 442 $\cdot$ www.tecnun.es}

% Nota: no se usa el entorno titlepage porque reinicia el contador de pagina y
% desincroniza la paridad fisica (los capitulos dejarian de caer en pagina impar).
\newcommand{\portadatfm}{%
  \thispagestyle{empty}
  \begin{center}
    \IfFileExists{\@logotecnun}
      {\includegraphics[height=2.2cm]{\@logotecnun}}
      {\framebox[6cm][c]{\rule{0pt}{2.2cm}\small [logo del centro]}}
    \vspace{2.5cm}

    {\large \@tfmtipo\par}
    \vspace{1.2cm}

    {\LARGE\bfseries \@tfmmaster\par}
    \vspace{2.5cm}

    {\Large \@tfmtitulo\par}
    \vspace{3cm}

    {\large \@tfmautor\par}
    \vspace{0.6cm}

    \ifx\@tfmdirector\empty\else
      {\normalsize Director: \@tfmdirector\par}
      \vspace{0.6cm}
    \fi

    \vfill
    {\normalsize \@tfmlugar, \@tfmfecha\par}
    \vspace{1.2cm}
    {\footnotesize \piecentro\par}
  \end{center}
  \cleardoublepage
}

% --- Paginas preliminares sin numeracion arabiga -----------------------------
\newcommand{\preliminar}[1]{%
  \chapter*{#1}%
  \addcontentsline{toc}{chapter}{#1}%
  \markboth{#1}{#1}%
}

