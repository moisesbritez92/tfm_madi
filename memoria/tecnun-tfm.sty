% --- Encabezados y pies ------------------------------------------------------
% Normas: encabezado par = titulo abreviado a la izquierda;
%         encabezado impar = nombre del alumno a la derecha;
%         pie centrado con "Pagina X de Y".
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
% En los preliminares (numeracion romana) se imprime solo el numero; en el cuerpo,
% "Pagina X de Y" como piden las normas. Se conmuta con \tfmpiecompletotrue.
\newif\if@tfmpiecompleto
\newcommand{\tfmpiecompleto}{\@tfmpiecompletotrue}
\newcommand{\piepagina}{%
  \small\if@tfmpiecompleto P\'agina \thepage\ de \pageref{LastPage}\else\thepage\fi}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[EL]{\small\@tfmtitulocorto}
\fancyhead[OR]{\small\@tfmautor}
\fancyfoot[C]{\piepagina}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\piepagina}%
  \renewcommand{\headrulewidth}{0pt}%
}

% --- Paginas de relleno en blanco -------------------------------------------
% En impresion a doble cara, \cleardoublepage inserta un verso vacio antes de
% cada capitulo. Esa hoja no debe llevar encabezado ni numero de pagina.
% (dentro de un .sty la arroba ya es letra: nada de \makeatletter aqui)
\renewcommand{\cleardoublepage}{%
  \clearpage
  \if@twoside
    \ifodd\c@page\else
      \hbox{}%
      \thispagestyle{empty}%
      \newpage
      \if@twocolumn\hbox{}\newpage\fi
    \fi
  \fi}

% --- Titulos de capitulo y epigrafe -----------------------------------------
% Formato del modelo: "1.  ESTADO DEL ARTE", "1.1.  Tags Chipless RFID"
\RequirePackage{titlesec}
% Normas: capitulo 16 pt, mayusculas, negrita, sin subrayar, siempre en pagina
% impar (lo garantiza la opcion openright de la clase). Apartado 14 pt, negrita,
% subrayado, en minusculas. Subapartado 13 pt, negrita, subrayado. La numeracion
% NO lleva punto final: "1.1 Esto es un apartado".
\newcommand{\tfmchapfont}{\fontsize{16}{19}\selectfont\bfseries}
\newcommand{\tfmsecfont}{\fontsize{14}{17}\selectfont\bfseries}
\newcommand{\tfmsubsecfont}{\fontsize{13}{16}\selectfont\bfseries}

\titleformat{\chapter}[hang]
  {\normalfont\tfmchapfont}{\thechapter.}{0.6em}{\MakeUppercase}
\titleformat{name=\chapter,numberless}[hang]
  {\normalfont\tfmchapfont}{}{0pt}{\MakeUppercase}
\titlespacing*{\chapter}{0pt}{0pt}{24pt}
\titlespacing*{name=\chapter,numberless}{0pt}{0pt}{24pt}

\titleformat{\section}[hang]
  {\normalfont\tfmsecfont}{\thesection}{0.6em}{\uline}
\titleformat{\subsection}[hang]
  {\normalfont\tfmsubsecfont}{\thesubsection}{0.6em}{\uline}
\titleformat{\subsubsection}[hang]
  {\normalfont\normalsize\bfseries}{\thesubsubsection}{0.5em}{\uline}
\titlespacing*{\section}{0pt}{16pt}{8pt}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}
\setcounter{secnumdepth}{3}

% Division menor sin numerar: no aparece en el indice.
\newcommand{\divisionmenor}[1]{%
  \par\vspace{8pt}\noindent{\normalsize\uline{#1}}\par\vspace{4pt}}

% --- Numeracion continua de figuras, tablas y ecuaciones ---------------------
% El modelo numera "Figura 1..14" y "Tabla 1..11" de forma corrida.
\RequirePackage{chngcntr}
\counterwithout{figure}{chapter}
\counterwithout{table}{chapter}
\counterwithout{equation}{chapter}

% --- Pies de figura y titulos de tabla --------------------------------------
% "Figura 1. Texto." debajo de la figura; "Tabla 1. Texto." encima de la tabla.
\RequirePackage[font=small,labelsep=period,justification=justified,
                singlelinecheck=false]{caption}
\RequirePackage{subcaption}
\captionsetup[figure]{name=Figura,position=below}
\captionsetup[table]{name=Tabla,position=above}

% Fuente de una figura o tabla ajena: \fuente{adaptado de \cite{clave}}
\newcommand{\fuente}[1]{\par\vspace{2pt}{\footnotesize\textit{Fuente: #1.}}}

% Nota aclaratoria al pie de una tabla, antes de la fuente
\newcommand{\notatabla}[1]{\par\vspace{2pt}{\footnotesize #1}}

% --- Indices (general, de figuras, de tablas) --------------------------------
\RequirePackage{tocloft}
\renewcommand{\cfttoctitlefont}{\tfmchapfont\MakeUppercase}
\renewcommand{\cftloftitlefont}{\tfmchapfont\MakeUppercase}
\renewcommand{\cftlottitlefont}{\tfmchapfont\MakeUppercase}
% babel-spanish fija estos nombres en \begin{document}: hay que sobrescribirlos despues
\AtBeginDocument{%
  \renewcommand{\contentsname}{\'Indice de contenidos}%
  \renewcommand{\listfigurename}{\'Indice de figuras}%
  \renewcommand{\listtablename}{\'Indice de tablas}%
  \renewcommand{\bibname}{Referencias}%
  \renewcommand{\appendixname}{Anexo}%
}
\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftchappagefont}{\bfseries}
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}   % puntos tambien en capitulos
\renewcommand{\cftchapaftersnum}{.}   % el capitulo si lleva punto: "1. TITULO"
% apartados y subapartados, sin punto: "1.1 Titulo"
\setlength{\cftsecnumwidth}{2.6em}
\setlength{\cftsubsecnumwidth}{3.4em}
\renewcommand{\cftfigpresnum}{Figura }
\renewcommand{\cfttabpresnum}{Tabla }
\newlength{\tfmfigwidth}\settowidth{\tfmfigwidth}{\bfseries Figura 99.\quad}
\setlength{\cftfignumwidth}{\tfmfigwidth}
\setlength{\cfttabnumwidth}{\tfmfigwidth}
\renewcommand{\cftfigaftersnum}{.}
\renewcommand{\cfttabaftersnum}{.}

% --- Codigo fuente -----------------------------------------------------------
\definecolor{tfmgris}{gray}{0.95}
\definecolor{tfmcomentario}{gray}{0.40}
\lstset{
  basicstyle=\ttfamily\footnotesize,
  commentstyle=\color{tfmcomentario}\itshape,
  keywordstyle=\bfseries,
  backgroundcolor=\color{tfmgris},
  frame=single, rulecolor=\color{gray},
  breaklines=true, breakatwhitespace=true,
  showstringspaces=false, captionpos=b,
  numbers=left, numberstyle=\tiny\color{gray}, numbersep=8pt,
  xleftmargin=16pt, framexleftmargin=16pt,
  literate={á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
           {ñ}{{\~n}}1 {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1
           {Ú}{{\'U}}1 {Ñ}{{\~N}}1 {¿}{{?`}}1 {¡}{{!`}}1
}
\renewcommand{\lstlistingname}{C\'odigo}

% --- Enlaces -----------------------------------------------------------------
\RequirePackage[hidelinks,breaklinks=true]{hyperref}
\hypersetup{
  pdftitle={\@tfmtitulo},
  pdfauthor={\@tfmautor},
  pdfsubject={\@tfmtipo. \@tfmmaster},
  bookmarksnumbered=true,
}
\RequirePackage[spanish,capitalise,nameinlink]{cleveref}
\crefname{figure}{Figura}{Figuras}
\crefname{table}{Tabla}{Tablas}
\crefname{equation}{Ecuaci\'on}{Ecuaciones}
\crefname{chapter}{Cap\'itulo}{Cap\'itulos}
